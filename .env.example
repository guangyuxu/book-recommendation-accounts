# Copy to .env and adjust. .env is git-ignored.

# --- Database (shared Postgres; this service OWNS the `accounts` schema) ---
# This service OWNS the account/profile tables' schema; the models are its source of truth and
# `make init-db` builds it. The code reads DATABASE_URL. Tables are pinned to the `accounts` schema
# via the libpq `search_path` option; init_db creates that schema if missing.
# Local (docker compose db service): postgres on localhost:5432
DATABASE_URL=postgresql+psycopg://book:book@localhost:5432/book?options=-csearch_path%3Daccounts
# Under docker compose, reach the db service by name instead:
# DATABASE_URL=postgresql+psycopg://book:book@db:5432/book?options=-csearch_path%3Daccounts

# --- Access tokens (RS256; this service is the ISSUER) ---
# Generate a keypair once with `make keygen` (writes keys/private.pem + keys/public.pem, gitignored):
#   openssl genpkey -algorithm RSA -pkcs8 -out keys/private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
# The service reads the PEM files at these default paths; override the paths, or pass the PEM inline:
# JWT_PRIVATE_KEY_PATH=keys/private.pem
# JWT_PUBLIC_KEY_PATH=keys/public.pem
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# Claims contract (the BFF verifier must match these): iss + aud are embedded in every token.
JWT_ISSUER=book-recommendation-accounts
JWT_AUDIENCE=book-recommendation
# JWT_ALGORITHM=RS256
# JWT_TTL_SECONDS=3600

# --- Internal (service-to-service) face ---
# Shared secret the agent presents as `X-Service-Token` to reach /internal/*. REQUIRED (non-empty).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCOUNTS_SERVICE_TOKEN=dev-internal-service-token

# --- HTTP / CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
